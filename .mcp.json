{
  "mcpServers": {
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "mobile-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@mobilenext/mobile-mcp@1.0.2"
      ]
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=mzkkkzbiejgvhwjyiokf&read_only=true"
    },
    "figma": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "set -a && source .env && set +a && exec npx -y figma-developer-mcp --figma-api-key=\"${FIGMA_PERSONAL_ACCESS_TOKEN}\" --stdio"
      ]
    }
  }
}