// LittleSprout — 基礎環境設定（LS-49）。
//
// SUPABASE_URL / SUPABASE_ANON_KEY 在這裡先給安全佔位值：CI 與任何尚未建立本機
// Secrets.xcconfig 的開發環境都會用這兩個值 build，佔位值不指向任何真實後端，
// 所以測試（不打真網路，見 LittleSproutTests）與純編譯都不受影響。
//
// 本機開發要接到真的 Supabase 專案：複製 Secrets.xcconfig.example 為 Secrets.xcconfig
// （已被 .gitignore 排除，不會進 repo）並填入真實值——取得方式是 supabase MCP 的
// get_project_url／get_publishable_keys（唯讀）。下面的 #include? 只在該檔存在時生效，
// 存在的話會覆蓋掉這兩個佔位值。
//
// 切換 local vs cloud：同一個 Secrets.xcconfig 改 SUPABASE_URL 即可——指向雲端專案 URL
// 就是 cloud，指向 `supabase start` 印出的本機 API URL（預設 http://127.0.0.1:54321）
// 就是 local；anon key 兩邊各自對應換掉。

// xcconfig 的 `//` 是註解起點，寫 `https://...` 會把網址從 `//` 那裡整段截斷成 `https:`
// （LS-49 實測踩到：INFOPLIST_KEY_SupabaseURL 因此解析成不合法的 URL，AppConfig 的
// precondition 直接讓 app 在啟動時崩潰）。用 `$()`（展開成空字串）拆開兩個斜線之間，
// 讓 parser 不把它們認成註解——SUPABASE_URL 與 Secrets.xcconfig 裡的同名設定都要維持這個寫法。
SUPABASE_URL = https:$()/$()/placeholder.supabase.co
SUPABASE_ANON_KEY = placeholder-anon-key-not-a-real-secret

// LS-217／LS-466：`aps-environment` entitlement 預設開（`PUSH_ENTITLEMENT = YES`）。沿革：LS-8 完成前
// 個人 team 不能簽 Push，曾預設 NO（只有模擬器 SDK 覆寫 YES）；團隊 VWBQ67Y2L6 的 App ID 已開 Push，
// 限制解除，裝置與 Archive 與模擬器同樣帶 `aps-environment`。CI 的 `CODE_SIGNING_ALLOWED=NO`
// 不簽 entitlements，不受影響。想暫時關掉（例如換到沒開 Push 的 team）：在（gitignored 的）
// `Secrets.xcconfig` 加 `PUSH_ENTITLEMENT = NO`——後定義者勝。
PUSH_ENTITLEMENT = YES
// LS-461：Associated Domains（`applinks:sproutday.app`，universal link）要在所有組態生效，所以
// 開關不決定「要不要引用 entitlements 檔」，只決定「引用哪一份」：NO → `LittleSprout.entitlements`
// （只有 associated-domains）；YES → `LittleSprout.Push.entitlements`（associated-domains＋
// `aps-environment`）。
CODE_SIGN_ENTITLEMENTS_NO = LittleSprout/LittleSprout.entitlements
CODE_SIGN_ENTITLEMENTS_YES = LittleSprout/LittleSprout.Push.entitlements
CODE_SIGN_ENTITLEMENTS = $(CODE_SIGN_ENTITLEMENTS_$(PUSH_ENTITLEMENT))

// LS-466：版本號由 scripts/ops/release-version.sh 寫入 Version.xcconfig（gitignored）；檔案不存在
// （CI 未跑腳本、新機器）時 #include? 靜默略過，退回 project.yml 的 fallback（0.0.0／1）。
// 放在 Secrets.xcconfig 之前：同名 key 後定義者勝，本機 Secrets.xcconfig 想臨時覆寫版本號仍可行。
#include? "Version.xcconfig"
#include? "Secrets.xcconfig"
