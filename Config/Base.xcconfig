// LittleSprout — 基礎環境設定（LS-49）。
//
// SUPABASE_URL / SUPABASE_ANON_KEY 在這裡先給安全佔位值：CI 與任何尚未建立本機
// Secrets.xcconfig 的開發環境都會用這兩個值 build，佔位值不指向任何真實後端，
// 所以測試（不打真網路，見 LittleSproutTests）與純編譯都不受影響。
//
// 本機開發要接到真的 Supabase 專案：複製 Secrets.xcconfig.example 為 Secrets.xcconfig
// （已被 .gitignore 排除，不會進 repo）並填入真實值——取得方式是 supabase MCP 的
// get_project_url／get_publishable_keys（唯讀）。下面的 #include? 只在該檔存在時生效，
// 存在的話會覆蓋掉這兩個佔位值。
//
// 切換 local vs cloud：同一個 Secrets.xcconfig 改 SUPABASE_URL 即可——指向雲端專案 URL
// 就是 cloud，指向 `supabase start` 印出的本機 API URL（預設 http://127.0.0.1:54321）
// 就是 local；anon key 兩邊各自對應換掉。

// xcconfig 的 `//` 是註解起點，寫 `https://...` 會把網址從 `//` 那裡整段截斷成 `https:`
// （LS-49 實測踩到：INFOPLIST_KEY_SupabaseURL 因此解析成不合法的 URL，AppConfig 的
// precondition 直接讓 app 在啟動時崩潰）。用 `$()`（展開成空字串）拆開兩個斜線之間，
// 讓 parser 不把它們認成註解——SUPABASE_URL 與 Secrets.xcconfig 裡的同名設定都要維持這個寫法。
SUPABASE_URL = https:$()/$()/placeholder.supabase.co
SUPABASE_ANON_KEY = placeholder-anon-key-not-a-real-secret

// LS-217：`aps-environment` entitlement 只能在 provisioning 真的開了 Push capability 時簽入
// ——LS-8（Apple Developer Program）未完成前，實機／個人 team 簽這個 entitlement 會直接建置
// 失敗。預設關（`PUSH_ENTITLEMENT = NO`）：`CODE_SIGN_ENTITLEMENTS` 這時展開成
// `CODE_SIGN_ENTITLEMENTS_NO`（空字串），完全不引用 `LittleSprout.entitlements`，CI／模擬器／
// 沒有 `Secrets.xcconfig` 的新機器都不受影響。LS-8 後想開：在（gitignored 的）
// `Secrets.xcconfig` 加一行 `PUSH_ENTITLEMENT = YES`——因為 `#include?` 在下面、後面的定義
// 覆蓋前面的同名 key（xcconfig 的變數是建置時展開，不是逐行覆蓋，覆蓋順序看的是「最後一次
// 賦值」，見 `LittleSprout.entitlements` 文件註解），`CODE_SIGN_ENTITLEMENTS` 就會展開成
// `CODE_SIGN_ENTITLEMENTS_YES`，正式引用該檔。
PUSH_ENTITLEMENT = NO
// merge-review R2 informational（orchestrator 裁示）：模擬器簽名不需要 provisioning profile，
// `aps-environment` 在 iphonesimulator SDK 下可以簽入，不受 LS-8 未完成的限制——加一條 SDK
// 條件覆寫，只在建置給 iphonesimulator（模擬器）時把旗標打開，讓「授權後 device_tokens 出現
// 本機一列」這條驗收可以在模擬器上實測。裝置（`iphoneos*`）與 Archive（`generic/platform=iOS`
// 走 `iphoneos` SDK）不受影響，仍是上面 `PUSH_ENTITLEMENT = NO` 那個未限定版本，等 LS-8 後才
// 在 `Secrets.xcconfig` 開。SDK 限定的設定不看檔案裡的先後順序、看的是「比對得上目前建置的
// SDK 就用它」，所以放在這裡（`PUSH_ENTITLEMENT = NO` 之後）純粹是就近註解，不影響效果。
PUSH_ENTITLEMENT[sdk=iphonesimulator*] = YES
CODE_SIGN_ENTITLEMENTS_NO =
CODE_SIGN_ENTITLEMENTS_YES = LittleSprout/LittleSprout.entitlements
CODE_SIGN_ENTITLEMENTS = $(CODE_SIGN_ENTITLEMENTS_$(PUSH_ENTITLEMENT))

#include? "Secrets.xcconfig"
