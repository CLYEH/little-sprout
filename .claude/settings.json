{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/ops/session-start.sh\"",
            "timeout": 30,
            "statusMessage": "巡檢中（scripts/ops/patrol.sh --brief）…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/pretool.sh\" || exit 2",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
