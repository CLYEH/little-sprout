# 複製成 android/local.properties（gitignored）後填值；對應 Secrets.xcconfig.example 的做法。
# 值只進本機 BuildConfig，不進 repo。anon key 為公開的 publishable key，仍不入版控以便各環境切換。
# sdk.dir 由 Android Studio 自動寫入；命令列自行指定 ANDROID_HOME 時可省略。
sdk.dir=/Users/<you>/Library/Android/sdk
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# Google 原生登入（Credential Manager）用的 OAuth Web client ID（Google Cloud → Credentials → Web application）。
# 缺值時 Google 登入會明確報錯，Email OTP／Apple 不受影響。
GOOGLE_WEB_CLIENT_ID=<web-client-id>.apps.googleusercontent.com
