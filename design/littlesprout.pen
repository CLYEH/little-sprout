                    {
                      "type": "path",
                      "id": "mzo0K",
                      "x": 0,
                      "y": 0,
                      "name": "Squircle r=115 (Pencil 圓弧近似)",
                      "geometry": "",
                      "viewBox": [
                        0,
                        0,
                        512,
                        512
                      ],
                      "width": 512,
                      "height": 512,
                      "stroke": "#8E2447",
                      "strokeWidth": 3
                    },
                    {
                      "type": "ellipse",
                      "id": "OxuA8",
                      "x": 34,
                      "y": 34,
                      "name": "Clearance TL",
                      "fill": "#6B1809",
                      "width": 12,
                      "height": 12
                    },
                    {
                      "type": "ellipse",
                      "id": "LMc6c",
                      "x": 466,
                      "y": 466,
                      "name": "Clearance BR",
