            0
          ],
          "children": [
            {
              "type": "text",
              "id": "Z9vqBX",
              "name": "H",
              "fill": "#2B141C",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "時間軸 (11) 版面節奏",
              "fontFamily": "Noto Sans TC",
              "fontSize": 22,
              "fontWeight": "700"
            },
            {
              "type": "frame",
              "id": "T9RteK",
              "name": "i",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "oiVcL",
                  "name": "stamp",
                  "fill": "#8E2447",
                  "textGrowth": "fixed-width",
                  "width": 118,
                  "content": "R3 · 11 全家族",
                  "lineHeight": 1.42,
                  "textAlign": "right",
                  "fontFamily": "Noto Sans TC",
                  "fontSize": 12,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "vY3tF",
                  "name": "l",
                  "fill": "#2B141C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "廢掉 R1/R2 的「空 frame spacer」機制（Spacer 16 / Spacer Section / Spacer To Section 三種曾同時存在，互相沒有一個算對——實測跨天 gap 16+28+16=60≠44）。R3 改用巢狀 gap＋padding，零 spacer frame：Feed（gap:$sp-section 44）只包 Day Group；每個 Day Group（gap:$sp-label 8）＝[Day Divider, Cards]；Cards（gap:$sp-item 16）＝同天卡片。三層 gap 各自負責一件事，機械上不可能算錯，因為沒有第二條路徑能疊加。實測：divider→首卡 8.0／卡→卡 16.0／組→組 44.0（4 個 Feed 家族一致）。filter→feed 同理，拿掉多餘的 Spacer 16，只留 Spacer Section 44（Qxema 空狀態原本 16+44+44=104，現在 44）。",
                  "lineHeight": 1.6,
                  "fontFamily": "Noto Sans TC",
                  "fontSize": 17,
                  "fontWeight": "normal"
                }
