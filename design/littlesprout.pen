                      "y": 34,
                      "name": "Clearance TL",
                      "fill": "#6B1809",
                      "width": 12,
                      "height": 12
                    },
                    {
                      "type": "ellipse",
                      "id": "LMc6c",
                      "x": 466,
                      "y": 466,
