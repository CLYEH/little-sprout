                  "fontFamily": "$font",
                  "fontSize": 17,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "oT3mD",
                  "name": "b",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "角托是黏在台紙上的紙袋，不是字。系統字級放大時它不跟著長大——放大的是內容，紙的裝訂方式不變（同一條理由讓沖印廠牌壓印 fs-imprint 12 也固定）。兩級尺寸只由卡寬決定：卡寬 ≤400 → 26pt；卡寬 >400 → 40pt，與 size 主題軸無關。可驗證：A11y / 04 在 AX3（body 40pt）下，四顆角托仍是 26pt。",
                  "lineHeight": 1.6,
                  "fontFamily": "$font",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            }
