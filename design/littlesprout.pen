            {
              "type": "text",
              "id": "Jembn",
              "name": "l",
              "fill": "#2B141C",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "14 相簿(iPhone/深色/AX3/iPad)、14b 空狀態：Tab-root，顯示 Tab Bar（相簿 icon 選中，視覺覆寫見下）；標題非系統 navigationTitle，是 Header Row 內的自畫 Title（比照時間軸／寶貝管理）；不用釘底 Action Bar（Tab-root 慣例，主動作在 Header Row「＋新增相簿」）；無失敗文案（純瀏覽）。",
              "lineHeight": 1.6,
              "fontFamily": "Noto Sans TC",
              "fontSize": 17,
