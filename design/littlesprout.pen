      "padding": 44,
      "children": [
        {
          "type": "text",
          "id": "ugSYX",
          "name": "NT",
          "fill": "$print-ink",
          "content": "LS-163 帳號密碼登入 · Handoff Notes",
          "lineHeight": 1.25,
          "fontFamily": "Noto Sans TC",
          "fontSize": 34,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "FWK4J",
          "name": "NS",
          "fill": "$print-ink-secondary",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "R1 首輪產出。新增歡迎頁「以帳號密碼登入」小字連結變體板（LS-17 01 板未改動，byte-identical）與帳號密碼登入畫面家族 P1（7 板）。零角托零染料池（一次性表單）。不做註冊／忘記密碼，僅供 App Store 審核帳號登入使用。",
          "lineHeight": 1.5,
