                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "2.1　本服務提供一個以「家庭」為單位的私密空間，讓家庭成員上傳與瀏覽孩子的照片、影片，撰寫日記，並以留言與愛心互動。",
                      "lineHeight": 1.7,
                      "fontFamily": "$font",
                      "fontSize": "$fs-body",
