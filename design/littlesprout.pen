                  "name": "stamp",
                  "fill": "#8E2447",
                  "textGrowth": "fixed-width",
                  "width": 118,
                  "content": "R1 · 08-iPad",
                  "lineHeight": 1.42,
                  "textAlign": "right",
                  "fontFamily": "Noto Sans TC",
                  "fontSize": 12,
                  "fontWeight": "700"
                },
                {
