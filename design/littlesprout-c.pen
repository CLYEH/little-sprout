                  "name": "T",
                  "fill": "#2B141C",
                  "content": "⑤ 尺寸與圓角 Size / Radius",
                  "fontFamily": "Noto Sans TC",
                  "fontSize": 22,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "M0c3Ei",
                  "name": "S",
                  "fill": "#553040",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "⚠ Pencil 的 height 屬性不接受變數參照（實測：Update(id,{height:\"$cta-h\"}) 被靜默丟棄，只有數字會存下來）。因此控制項高度改由「內容高度 + 變數化的上下 padding」推導——這反而更貼近 Dynamic Type 的真實行為：字級長大時控制項自動跟著長高，不需要另一組 ax3 高度值。實作端請用 .frame(minHeight:) 或 .padding(.vertical:) 對齊下表推導出的高度。",
                  "lineHeight": 1.5,
                  "fontFamily": "Noto Sans TC",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
