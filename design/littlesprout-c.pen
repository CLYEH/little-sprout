                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "bPF6I",
              "name": "Spec",
              "width": 1100,
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "frame",
                  "id": "RnyfD",
                  "name": "S",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 4,
                  "children": [
                    {
                      "type": "text",
                      "id": "MS7Wx",
                      "name": "h",
                      "fill": "#2B141C",
                      "content": "分層意圖（Icon Composer / Liquid Glass）",
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 15,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "iqEVt",
                      "name": "b",
                      "fill": "#553040",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "分層（Icon Composer，三層，不超過 4 層上限）。所有數字以 512 稿面計，1024 master ×2。\n【背景層】相簿台紙：窗光 radial（bg-lit → bg，圓心 14%/2%），純漸層無銳利邊，讓系統鏡面高光整片掃過。\n【中景層】相紙 420×420 @ (46,46)＝貼面 82%（R2 是 336＝65.6%，低於官方模板 52–75% 的上緣，在 60pt 以下整個標識縮成一個小方塊）。外邊 46。正方硬角（沖印品沒有圓角）＋兩顆染料池（TL 0.42／BR 0.14）＋紙影 (0,5,20)。\n【前景層】兩個角托 105×105（外擴 14 壓到台紙上）＋「芽」248pt＝墨高約 35% 稿面／42% 紙面。角托獨立一層，讓玻璃高光在它的斜邊上折一次——全 icon 唯一會亮的地方。\n\n【池子是設計比例，不是 lit() 的求值】icon 不是裝置畫面，沒有 viewport 可以代入公式。兩顆池 0.42:0.14＝3:1 是刻意選的比例，落在 app 內實測範圍（06 卡 1.8:1 到 01-iPad 8:1）之內。這裡誠實說清楚：icon 借的是染料階的規則，不是它的數值。",
                      "lineHeight": 1.6,
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Xd0nV",
                  "name": "S",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 4,
                  "children": [
                    {
                      "type": "text",
                      "id": "LY3N0",
                      "name": "h",
                      "fill": "#2B141C",
                      "content": "為什麼是兩個角托、不是四個",
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 15,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "h0mTtR",
                      "name": "b",
                      "fill": "#553040",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "四個角托在 60pt 會糊成一圈邊。對角兩顆（左上／右下）保留「被裱住」的意思，又在小尺寸留下一個不對稱、可辨識的剪影——而且對角正好是窗光最強與最弱的兩端，染料池深淺差 3 倍，icon 自己就在演示染料階。\n\n【R3 · 40pt 重驗（實測，不是宣稱）】R2 宣稱 40pt 站得住，實測是角托消失、字成糊。放大量體後重驗：40pt 時紙 33、角托 8、字 19（墨高 47.5% 於畫布）。結論分兩段講——40pt：兩顆角托仍看得出是兩個斜角，「芽」可辨識為一個字但讀不出筆畫，作為 app 的識別剪影成立。60pt：「芽」的橫豎鉤都分得開，讀得出來。所以 40pt 是「認得出是誰」，60pt 才是「讀得出寫什麼」，兩者不要混為一談。",
                      "lineHeight": 1.6,
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "hs6ry",
                  "name": "S",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 4,
                  "children": [
                    {
                      "type": "text",
                      "id": "fUYDo",
                      "name": "h",
                      "fill": "#2B141C",
                      "content": "為什麼是「芽」不是插畫",
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 15,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "jx0GP",
                      "name": "b",
                      "fill": "#553040",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "① 稿約禁止手繪吉祥物，且插畫式 icon 在 60pt 一律糊。② 對長輩，一個清楚的中文字比抽象符號好認。③ 「芽」是產品名的第二個字，標識與字標因此是同一物的兩個裁切，不是兩個要互相解釋的東西。④ 深玫紅 $accent 是全設計唯一飽和色，icon 用掉它一次——與「一畫面一實心 accent」同一條規則。",
                      "lineHeight": 1.6,
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "fhbIh",
                  "name": "S",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 4,
                  "children": [
                    {
                      "type": "text",
                      "id": "OJHcO",
                      "name": "h",
                      "fill": "#2B141C",
                      "content": "標識與字標的關係",
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 15,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "sDbW3",
                      "name": "b",
                      "fill": "#553040",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "標識（App icon／頭像／分享卡）＝被裱起來的「芽」。字標（歡迎頁／App Store）＝萌芽日記。四字等大不拆大小——四個等大的字是一個詞，拆成「萌芽＋日記」會被讀成品牌＋品類；等大也只需要一個字級 token，AX3 一起長大。\n\n【橫式鎖版規格（R3 補齊）】\n· 比例：標識高 ＝ 字標大字高 × 1.4；標識 ↔ 字標間距 ＝ 標識高 × 0.25。\n· 淨空 clear space：四邊各 ＝ 標識高 × 0.5，淨空內不得放任何字、線、邊框或另一個標誌。\n· 最小尺寸：橫式鎖版最小標識高 60pt（印刷 12mm）。低於此一律改用單獨標識，不要縮鎖版。\n· 單色版：見「還沒做」段的單色規則，鎖版與標識共用同一套。\n· 錯用：不得改變兩者相對大小、不得換行成直式（另做直式鎖版）、不得替換字標字體、不得把標識放進另一個框裡。\n\n【眉標 LITTLE SPROUT 的退場規則（R3 · 這是本輪的表態）】\n· app 介面內：眉標已離開視線起點。它不再是文字區塊的第一行，改成印在「入口那張紙」下緣的沖印廠牌壓印（01 相紙、01-iPad 登入卡），置中、12pt、ls 3.5、不吃 Dynamic Type——因為它印在紙上，不是 UI。\n· 橫式鎖版內：眉標只在鎖版寬度 ≥ 240pt 時出現（14pt/ls 3）。低於 240pt 一律退場，只留「萌芽日記」——一個讀不到的字比沒有更糟。\n· 中英並置只在這兩個地方成立；其餘任何地方不要為了「看起來國際」再放一次英文名。",
                      "lineHeight": 1.6,
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "BLBqC",
                  "name": "S",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 4,
                  "children": [
                    {
                      "type": "text",
                      "id": "EL5Wc",
                      "name": "h",
                      "fill": "#2B141C",
                      "content": "還沒做（下輪）",
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 15,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "rsim0",
                      "name": "b",
                      "fill": "#553040",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "【單色版（R3 補）】全墨 #2B141C 與全白 #FBEBEC 兩版。單色下顏色不能分層，改用形狀分：紙＝100% 實心方塊，角托＝同色 55% 疊在紙上（疊出的深淺就是唯一的層次），「芽」從紙上挖空（knockout）。池與紙影在單色版一律不畫——它們是光的資訊，單色版沒有光。\n\n【同心圓角的例外條款（R3 寫進規則）】全 app 遵守 iOS 26/27 同心圓角（外 18／內 14）。兩個刻意例外，兩個都同一個理由：實體物有它自己的角。① 沖印品／相紙一律 radius 0——相紙是裁刀切出來的，沒有圓角。② App icon 的外框 115/512＝22.46%，是系統 superellipse 遮罩的近似，不是本設計選的半徑；Pencil 沒有超橢圓，生產一律走 Icon Composer 的真遮罩，不要沿用這個數字。\n\n還沒做（下輪）：① tinted／clear 單色變體實檔。② 真正的 superellipse 遮罩。③ 顆粒層與紙纖維在 1024 下的取樣。④ 通知圖示、Watch 圈形遮罩、App Store 1024 無遮罩版安全區。⑤ 與 LS-33 產出物對帳。",
                      "lineHeight": 1.6,
                      "fontFamily": "Noto Sans TC",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
