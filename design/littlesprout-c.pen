                  "fontFamily": "Noto Sans TC",
                  "fontSize": 17,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "V05LMl",
                  "name": "l",
                  "fill": "#2B141C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "【R3 · Email 斷行】R2 在 07b 用硬換行 \\n 示範長 email 的折行——那是把一次量測凍進內容裡，換個字級就錯。已改成 textGrowth: fixed-width 自動斷行。A11y-04 的「我要自己建立家庭」同樣拿掉硬換行。\n實作：長 email 用 .lineLimit(2) ＋ .truncationMode(.middle)，優先在 @ 之後斷行由 Text 的斷行規則自然處理，不要手動插字元。",
                  "lineHeight": 1.6,
                  "fontFamily": "Noto Sans TC",
                  "fontSize": 17,
                  "fontWeight": "normal"
                }
              ]
            }
