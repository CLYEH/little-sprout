            {
              "type": "frame",
              "id": "SH4s4",
              "name": "i1",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "ODBLD",
                  "name": "stamp",
                  "fill": "#8E2447",
