            0,
            0,
            0
          ],
          "children": [
            {
              "type": "frame",
              "id": "TGNn7",
              "name": "SecHead",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 4,
              "children": [
                {
                  "type": "text",
                  "id": "WL3Gh",
                  "name": "T",
                  "fill": "#2B141C",
                  "content": "① 色彩 Color",
                  "fontFamily": "Noto Sans TC",
                  "fontSize": 22,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "Y4zQ26",
                  "name": "S",
                  "fill": "#553040",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "色彩極度稀缺：整份設計只有一個飽和色（accent 深玫紅 #8E2447），每畫面最多出現一次實心。連結用墨色＋底線，icon／badge 一律中性。中性階本身就是粉——每一階 B ≥ G（rose 家族），不是在米色上加粉紅濾鏡：對照軌 A 的暖白系統每一階 B < G（cream 家族），色相由 13–39° 轉到 334–356°。錯誤色（磚紅 hue 9）是唯一家族外的色相，且錯誤永遠同時用形（粗底線）與字說明，不靠顏色單獨承載。",
                  "lineHeight": 1.5,
                  "fontFamily": "Noto Sans TC",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
