                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "YfDEu",
                  "name": "l",
                  "fill": "#2B141C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "【R2 · Courier Prime 限縮】打字機數字面只用在展示級距（≥36pt）：邀請碼 fs-code 60、OTP fs-otp 36。所有行內數字改 Noto Sans TC ＋ .monospacedDigit()：倒數秒數、剩餘次數、到期日膠囊、等待時間、時間戳、錯誤次數。理由：Courier Prime 的 cap-height 只有 66%，塞在 13/17pt 的中文行裡會比周圍矮一截、像上標，反而削弱了它自己。⚠ 與 reviewer 清單的差異：findings 把「倒數」列在展示級距，但本稿的倒數是 17pt 行內字，套 ≥36pt 規則就必須離開 Courier；要讓它留在打字機面就得把它做成展示級距的大字倒數＝新增畫面，超出本輪 scope。規則優先於清單。規格板上的數值仍用 Courier——那是圖說不是 UI。",
                  "lineHeight": 1.6,
                  "fontFamily": "Noto Sans TC",
                  "fontSize": 17,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "orS6N",
              "name": "i0",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "f2Gm3",
                  "name": "d",
                  "fill": "#8E2447",
                  "content": "—",
                  "fontFamily": "Noto Sans TC",
                  "fontSize": 17,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "h7EnT",
                  "name": "l",
                  "fill": "#2B141C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "【R2 · 邀請碼字母集（設計對後端的規格請求）】排除易混字元 Q O 0 I L 1（Crockford Base32 前例）。剩餘 30 字元：2-9 ＋ A B C D E F G H J K M N P R S T U V W X Y Z。6 位 → 30^6 ≈ 7.29×10^8 ≈ 29.4 bit。⚠ 若 LS-33 需維持 40 bit，6 位英數不可能達成（需 ~100 個符號），要嘛加到 8 位（30^8 ≈ 39.2 bit）要嘛放寬字母集——設計端立場：寧可 7-8 位也不要讓長輩把 O 唸成零。稿內示例碼已由「K7M 2QD」改為「K7M 2FD」，06/06b/06c 輸入格第 5 格 Q → F。",
                  "lineHeight": 1.6,
                  "fontFamily": "Noto Sans TC",
                  "fontSize": 17,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "huX3I",
              "name": "i0",
