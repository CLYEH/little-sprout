          "children": [
            {
              "type": "text",
              "id": "VVsHa",
              "name": "H1",
              "fill": "#2B141C",
              "content": "設計語言 v3.1 · 褪色相片粉調",
              "lineHeight": 1.25,
              "fontFamily": "Noto Sans TC",
              "fontSize": 34,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "QwdaI",
              "name": "H1 Sub",
              "fill": "#553040",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "取材自家族相簿裡真正會發生的事：彩色相紙的青色染料最先死掉，三十年後的家庭照整體偏洋紅。所以整個 app 只有一條染料階——從受光的紙（blush）到留在暗處的墨（桑葚），連中性階每一階都是 rose（B ≥ G）。照片是全app唯一不粉的東西。所有對比值為實測（WCAG 2.1 相對亮度），一律以各自的最不利點計。",
              "lineHeight": 1.6,
              "fontFamily": "Noto Sans TC",
              "fontSize": 17,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "PsZ61",
          "name": "Sec ① 色彩 Color",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 16,
          "padding": [
